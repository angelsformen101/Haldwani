# ==============================================================================
# Apache / LiteSpeed / cPanel Configuration for CityHaldwani
# ==============================================================================

RewriteEngine On

# 1. Secret Admin Access: Only /admin! or /admin!/ serves the admin panel
RewriteRule ^admin!/?$ admin/index.html [L]

# 2. Block direct access to /admin, /admin/, and /admin/*
RewriteRule ^admin(/.*)?$ /404.html [R=404,L]

# 3. Clean URLs: Serve .html file if existing without showing .html in URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 4. Custom Error Documents
ErrorDocument 404 /404.html
